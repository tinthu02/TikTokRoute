+dalat_poi_gmaps.csv
+dalat_poi_scored.csv
+dalat_route_phase1.csv
+dalat_route_2days.csv
+dalat_route_4days.csv
+dalat_route_greedy_3d.csv
+dalat_route_greedy_4d_3days.csv
+```
