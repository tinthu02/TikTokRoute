+dalat_poi_extracted_extra2.csv
+dalat_poi_extracted_extra3.csv
+dalat_poi_clean.csv
+dalat_poi_clean_fix.csv          # file gây bug, KHÔNG dùng nữa
+dalat_poi_unmatched.csv
